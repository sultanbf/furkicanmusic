      },
      "id": "11111111-1111-4111-8111-111111111101",
      "name": "Webhook (Siteden Gelen)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "11111111-1111-4111-8111-111111111101"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.sunoapi.org/api/v1/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.SUNO_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "prompt",
              "value": "={{ $json.lyrics ? $json.lyrics : $json.prompt }}"
            },
            {
              "name": "style",
              "value": "={{ $json.lyrics ? $json.style : '' }}"
            },
            {
              "name": "title",
              "value": "={{ $json.lyrics ? $json.title : '' }}"
            },
            {
              "name": "customMode",
              "value": "={{ $json.lyrics ? true : false }}"
            },
            {
              "name": "instrumental",
              "value": "={{ $json.instrumental ? true : false }}"
            },
            {
              "name": "model",
              "value": "={{ $json.model || 'V4_5' }}"
            },
            {
              "name": "vocalGender",
              "value": "={{ $json.vocalGender === 'kadin' ? 'f' : 'm' }}"
            },
            {
              "name": "callBackUrl",
              "value": ""
            }
          ]
        },
        "options": {}
      },
