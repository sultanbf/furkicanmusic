              "id": "if-timeout-0001",
              "leftValue": "={{ $json.count }}",
              "rightValue": 24,
              "operator": {
                "type": "number",
                "operation": "larger"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "IF: Zaman Aşımı mı?",
