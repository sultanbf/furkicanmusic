          "conditions": [
            {
              "id": "if-success-0001",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "SUCCESS",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "11111111-1111-4111-8111-111111111109",
      "name": "IF: Başarılı mı?",
